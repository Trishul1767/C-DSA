//Creating a node

struct Node* createNode(int data) {
    struct Node *newNode;

    newNode = malloc(sizeof(struct Node));

    newNode->data = data;
    newNode->left = NULL;
    newNode->right = NULL;

    return newNode;
}

// Tree implementation
struct Node *root = createNode(10);

root->left = createNode(20);                                                            
root->right = createNode(30);
                                                                                                                     10
                                                                                                                   /    \
                                                                                                                 20      30
                                                                                                                /  \
                                                                                                               40   50
root->left->left = createNode(40);
root->left->right = createNode(50);

