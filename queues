
#include<stdio.h>
#include<stdlib.h>
#define MAX 3
int f=-1;
int r=-1;
int queue[MAX];

//inserting at the end 
//deleting at the front
//incrementing the rear every insertion and front if front is -1
// don't forget to increment the front if the queue is empty


void enqueue(){
    int data;
    if(r==MAX-1){
        printf("overflow\n");
        return;
    }
    if(f==-1){
        f++;
    }
    printf("enter data\n");
    scanf("%d",&data);
    r++;
    queue[r]=data;
}

void dequeue(){
    if(f==-1){
        printf("underflow\n");
        return;
    }
    else{
        printf("%d has been removed\n",queue[f]);
        if(r==f){
            f=-1;
            r=-1;
        }
        else{
            f++;
        }
    }
}

void display(){
    int i;
    if(f==-1){
        printf("empty\n");
        return;
    }
    printf("Queue: ");
    for(i=f;i<=r;i++){
        printf("%d ",queue[i]);
    }
    printf("\n");
}

void peek(){
    if(f==-1){
        printf("empty\n");
        return;
    }
    printf("Front element is %d",queue[f]);
}
int main(){

    while(1){

        printf("1.insert\n");

        printf("2.delete\n");

        printf("3.peek\n");

        printf("4.display\n");

        printf("5.exit\n");

        int b;

        scanf("%d",&b);

        switch(b){

            case 1:

                enqueue();

                break;

            case 2:

            dequeue();

            break;

            case 3:

            peek();

            break;

            case 4:

            display();

            break;

            case 5:

            exit(0);
            default:
            printf("enter valid choice!\n");

        }

    }

} 

