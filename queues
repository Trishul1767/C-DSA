#include <stdio.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;
//inserting at the end 
//incrementing the rear every insertion and front if front is -1

void enqueue(int value)
{
    if (rear == SIZE - 1)
    {
        printf("Queue Overflow\n");
    }
    else
    {
        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = value;
    }
}
