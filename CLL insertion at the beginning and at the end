void del_begin(){

    struct Node *temp, *last;

    if(start == NULL){
        printf("Underflow\n");
        return;
    }

    if(start->next == start){
        free(start);
        start = NULL;
        return;
    }

    last = start;

    while(last->next != start){
        last = last->next;
    }

    temp = start;
    start = start->next;
    last->next = start;
    free(temp);
}

