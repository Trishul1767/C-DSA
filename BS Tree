#include<stdio.h>
#include<stdlib.h>
//BST

struct Node{
    int data;
    struct Node* left;
    struct Node* right;
};

struct Node *createNode(int data){
    struct Node *newnode =malloc(sizeof(struct Node));
    newnode->data = data;
    newnode->left = NULL;
    newnode->right = NULL;
    return newnode;
}
