#include <stdio.h>
#include <stdlib.h>

#define MAX 5

int queue[MAX];
int f = -1;
int r = -1;

void enqueue()
{
    int data;

    if ((r + 1) % MAX == f)
    {
        printf("Overflow\n");
        return;
    }

    printf("Enter data: ");
    scanf("%d", &data);

    if (f == -1)
    {
        f = 0;
        r = 0;
    }
    else
    {
        r = (r + 1) % MAX;
    }

    queue[r] = data;
}

void dequeue()
{
    if (f == -1)
    {
        printf("Underflow\n");
        return;
    }

    printf("%d has been removed\n", queue[f]);

    if (f == r)
    {
        f = -1;
        r = -1;
    }
    else
    {
        f = (f + 1) % MAX;
    }
}

void display()
{
    int i;

    if (f == -1)
    {
        printf("Empty\n");
        return;
    }

    printf("Queue: ");

    i = f;

    while (1)
    {
        printf("%d ", queue[i]);

        if (i == r)
            break;

        i = (i + 1) % MAX;
    }

    printf("\n");
}

void peek()
{
    if (f == -1)
    {
        printf("Empty\n");
        return;
    }

    printf("Front element: %d\n", queue[f]);
}
