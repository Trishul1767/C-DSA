#include<stdio.h>

void enqueue()
{
    int data;

    if ((r + 1) % MAX == f)
    {
        printf("Overflow\n");
        return;
    }

    printf("Enter data: ");
    scanf("%d", &data);

    if (f == -1)
    {
        f = 0;
        r = 0;
    }
    else
    {
        r = (r + 1) % MAX;
    }

    queue[r] = data;
}

void dequeue()
{
    if (f == -1)
    {
        printf("Underflow\n");
        return;
    }

    printf("%d has been removed\n", queue[f]);

    if (f == r)
    {
        f = -1;
        r = -1;
    }
    else
    {
        f = (f + 1) % MAX;
    }
}
