#include <stdio.h>

void merge(int a[], int l, int m, int r, int temp[])
{
    int i = l;
    int j = m + 1;
    int k = l;

    while (i <= m && j <= r)
    {
        if (a[i] <= a[j])
            temp[k] = a[i];
            k++;
            i++;        
        else
            temp[k] = a[j];
            k++;
            j++;
    }

    while (i <= m)
        temp[k] = a[i];
        k++;
        i++;

    while (j <= r)
        temp[k] = a[j];
        k++;
        j++;

    for (i = l; i <= r; i++)
        a[i] = temp[i];
}

void mergeSort(int a[], int l, int r, int temp[])
{
    if (l >= r)
        return;

    int m = l + (r - l) / 2;

    mergeSort(a, l, m, temp);
    mergeSort(a, m + 1, r, temp);

    merge(a, l, m, r, temp);
}

int main()
{
    int a[] = {6, 3, 8, 2};
    int n = 4;
    int temp[4];

    mergeSort(a, 0, n - 1, temp);

    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

