insortion sort
Take one element as sorted and from the next one compare it with the previous ones 
if previous one greater then move that to the right.
else place it in the empty place
#include <stdio.h>

int main()
{
    int a[] = {5, 3, 4, 1, 2};
    int n = 5;
    int i, j, key;

    for (i = 1; i < n; i++)
    {
        key = a[i];
        j = i - 1;

        while (j >= 0 && a[j] > key)
        {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

