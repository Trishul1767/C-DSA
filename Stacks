#define MAX 5
int stack[MAX];
int top=-1;
void push(){
  int data;
  if(top==MAX-1){
    printf("overflow\n");
    return;
  }
  printf("enter data\n");
  scanf("%d",%data);
  top++;
  stack[top]=data;
}

void pop()
{
    if(top == -1)
    {
        printf("Stack Underflow\n");
        return;
    }

    int item = stack[top];

    top--;

    printf("%d deleted\n", item);
}
